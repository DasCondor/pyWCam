# Copy to .env. Never commit credentials.
PYWCAM_BIND=127.0.0.1
PYWCAM_PORT=8080
PYWCAM_USERNAME=viewer
# Blank = generate a new password each time the service starts (see logs).
PYWCAM_PASSWORD=
# USB Linux host: supply numeric device group ID from stat -c '%g' /dev/video0.
PYWCAM_VIDEO_DEVICE=/dev/video0
# PYWCAM_VIDEO_GID=
PYWCAM_WIDTH=1280
PYWCAM_HEIGHT=720
PYWCAM_FPS=15
# Use single quotes around URLs containing $ or # for literal Compose values.
# PYWCAM_SOURCE='rtsp://user:password@192.168.1.10:554/stream'

# Optional MFA: generate a secret and enroll in an authenticator app first.
# Docker MFA requires the TLS override and a fixed password.
# PYWCAM_MFA_SECRET=
# PYWCAM_TLS_DIR=./tls
